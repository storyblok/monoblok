{
  "compilerOptions": {
    // Deliberately standalone rather than extending `../tsconfig.json`: that
    // config emits declarations into `dist`, and inheriting its `outDir` makes
    // TypeScript demand an explicit `rootDir` for the spec directory (TS5011).
    // Specs are bundled by Cypress and emit nothing.
    "target": "ES2017",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Cypress compiles specs with its own bundled webpack + ts-loader and
    // injects `downlevelIteration`, which TypeScript 6 reports as deprecated.
    // The option is not ours to remove, so silence it here only.
    "ignoreDeprecations": "6.0",
    "types": ["cypress"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": []
}
