{
  "name": "@storyblok/live-preview",
  "version": "0.5.0",
  "private": false,
  "description": "Official Live Preview integration for the Storyblok Headless CMS",
  "keywords": [
    "live-preview",
    "storyblok"
  ],
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/live-preview#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "Storyblok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/live-preview"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate:openapi": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate.ts",
    "test": "vp test run",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@storyblok/preview-bridge": "^2.1.6"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/openapi-codegen": "workspace:*",
    "@types/node": "^24.11.0",
    "bumpp": "^10.4.1",
    "jsdom": "^25.0.0",
    "oxlint": "1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "nx": {
    "targets": {
      "generate:openapi": {
        "inputs": [
          "{projectRoot}/scripts/generate.ts",
          "{projectRoot}/package.json",
          "openapiCodegen"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true,
        "dependsOn": [
          "@storyblok/openapi-codegen:build"
        ]
      }
    }
  }
}
