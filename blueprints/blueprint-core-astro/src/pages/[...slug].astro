---
import { StoryblokPreview } from '@storyblok/astro';
import Layout from '../layouts/Layout.astro';
import { storyblokClient, StoryblokBlock } from '../storyblok';

const { slug } = Astro.params;

const { data } = await storyblokClient.stories.get(slug || 'home', {
	query: { version: 'draft' },
	throwOnError: true,
});

const story = data.story;
---

<Layout>
	<StoryblokBlock block={story.content} />
	<StoryblokPreview />
</Layout>
