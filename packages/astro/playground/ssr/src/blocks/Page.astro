---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokBlock from "@storyblok/astro/StoryblokBlock.astro";
import type { StoryblokBlockData } from "@storyblok/astro";

const { block } = Astro.props;
---

<main {...storyblokEditable(block)} data-test="page-component">
  {
    block.body?.map((child: StoryblokBlockData) => {
      return <StoryblokBlock block={child} />;
    })
  }
</main>
