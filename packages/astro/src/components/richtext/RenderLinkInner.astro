---
import { type StoryblokRichTextTextNode, getInnerMarks } from '@storyblok/richtext';
import type { StoryblokAstroRichTextRenderContext } from '../../richtext-helpers';
import RenderTextNodeWithMarks from './RenderTextNodeWithMarks.astro';

interface Props {
  nodes: StoryblokRichTextTextNode[];
  options: StoryblokAstroRichTextRenderContext;
}
const { nodes, options } = Astro.props;
---

{
  nodes.map((node) => {
    const innermarks = getInnerMarks(node);
    return (
      <RenderTextNodeWithMarks
        node={node}
        marks={innermarks}
        options={options}
      />
    );
  })
}
