{
  "name": "storyblok",
  "version": "4.22.3",
  "description": "Storyblok CLI",
  "keywords": [
    "cli",
    "javascript",
    "node",
    "storyblok"
  ],
  "license": "MIT",
  "author": "Alvaro Saburido <hola@alvarosaburido.dev> (https://github.com/alvarosabu/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "branch": "main",
    "directory": "packages/cli"
  },
  "bin": {
    "storyblok": "./dist/index.mjs"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "import": {
        "types": "./dist/config/index.d.mts",
        "default": "./dist/config/index.mjs"
      },
      "require": {
        "types": "./dist/config/index.d.cts",
        "default": "./dist/config/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "release": "release-it",
    "dev": "vp pack --watch",
    "debug": "node --inspect-brk --loader tsx src/index.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test:ui": "vp test --ui",
    "start": "pnpm run build && node dist/index.mjs",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "generate:openapi": "tsx scripts/generate.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "@storyblok/js": "workspace:^",
    "@storyblok/management-api-client": "workspace:^",
    "@storyblok/region-helper": "workspace:^",
    "@storyblok/schema": "workspace:^",
    "@topcli/spinner": "^2.1.2",
    "async-sema": "^3.1.1",
    "c12": "^3.3.0",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "commander": "^13.1.0",
    "diff": "^8.0.4",
    "dotenv": "catalog:",
    "filenamify": "^6.0.0",
    "jiti": "catalog:",
    "json-schema-to-typescript": "^15.0.4",
    "jsonpath-plus": "10.4.0",
    "minimatch": "^10.0.3",
    "octokit": "^5.0.3",
    "ohash": "^2.0.11",
    "open": "^10.1.2",
    "pathe": "catalog:",
    "read-package-up": "^11.0.0",
    "storyblok-js-client": "workspace:^"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "10.0.0",
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/openapi-codegen": "workspace:*",
    "@types/cli-progress": "^3.11.6",
    "@types/diff": "^8.0.0",
    "@types/inquirer": "^9.0.8",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^4.1.10",
    "memfs": "^4.17.1",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "release-it": "^18.1.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "^11.1.0",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "generate:openapi": {
        "inputs": [
          "{projectRoot}/scripts/generate.ts",
          "{projectRoot}/package.json",
          "openapiCodegen"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true,
        "dependsOn": [
          "@storyblok/openapi-codegen:build"
        ]
      }
    }
  }
}
