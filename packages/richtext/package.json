{
  "name": "@storyblok/richtext",
  "version": "5.2.1",
  "description": "Storyblok RichText Resolver",
  "keywords": [
    "resolver",
    "richtext",
    "storyblok"
  ],
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/richtext#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "Storyblok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/richtext"
  },
  "files": [
    "*.d.ts",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "markdown-parser": [
        "./dist/markdown-parser.d.cts"
      ],
      "html-parser": [
        "./dist/html-parser.d.cts"
      ],
      "test-utils": [
        "./dist/test-utils.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./html-parser": {
      "import": "./dist/html-parser.mjs",
      "require": "./dist/html-parser.cjs"
    },
    "./markdown-parser": {
      "import": "./dist/markdown-parser.mjs",
      "require": "./dist/markdown-parser.cjs"
    },
    "./test-utils": {
      "import": "./dist/test-utils.mjs",
      "require": "./dist/test-utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test:types": "tsc -p tsconfig.json",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:ui": "vp test --ui",
    "playground": "cd playground && npm run dev",
    "playground:all": "pnpm -r --parallel --filter='./playground/*' run dev",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "generate": "tsx src/static/generate/index.ts",
    "generate:openapi": "tsx scripts/generate.ts",
    "dev": "vp pack --watch",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-blockquote": "^3.22.3",
    "@tiptap/extension-bold": "^3.22.3",
    "@tiptap/extension-code": "^3.22.3",
    "@tiptap/extension-code-block": "^3.22.3",
    "@tiptap/extension-document": "^3.22.3",
    "@tiptap/extension-emoji": "^3.22.3",
    "@tiptap/extension-hard-break": "^3.22.3",
    "@tiptap/extension-heading": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/extension-horizontal-rule": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-italic": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-list": "^3.22.3",
    "@tiptap/extension-paragraph": "^3.22.3",
    "@tiptap/extension-strike": "^3.22.3",
    "@tiptap/extension-subscript": "^3.22.3",
    "@tiptap/extension-superscript": "^3.22.3",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-text": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/html": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/suggestion": "^3.22.3",
    "emojibase": "^17.0.0",
    "happy-dom": "^20.8.8",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/openapi-codegen": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.5.2",
    "oxfmt": "0.61.0",
    "oxlint": "catalog:",
    "pathe": "catalog:",
    "prosemirror-model": "^1.25.4",
    "release-it": "^18.1.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        200
      ]
    }
  },
  "nx": {
    "implicitDependencies": [
      "!@storyblok/vue",
      "!@storyblok/playground-*"
    ],
    "targets": {
      "generate": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/src/static/render-map.generated.ts",
          "{projectRoot}/src/static/richtext-element-types.generated.ts"
        ]
      },
      "generate:openapi": {
        "inputs": [
          "{projectRoot}/scripts/generate.ts",
          "{projectRoot}/package.json",
          "openapiCodegen"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true,
        "dependsOn": [
          "@storyblok/openapi-codegen:build"
        ]
      },
      "build": {
        "dependsOn": [
          "generate",
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist/**"
        ]
      }
    }
  }
}
