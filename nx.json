{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultProject": "main",
  "parallel": 5,
  "namedInputs": {
    "cjsInterop": ["{workspaceRoot}/tools/cjs-interop-plugin.ts"],
    "openapiCodegen": [
      "{workspaceRoot}/tools/openapi-codegen/spec.lock",
      "{workspaceRoot}/tools/openapi-codegen/src/**",
      "{workspaceRoot}/tools/openapi-codegen/specs/**",
      "{workspaceRoot}/tools/openapi-codegen/templates/**",
      "{workspaceRoot}/tools/openapi-codegen/upstream/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "generate:openapi"],
      "inputs": ["default", "^default", "cjsInterop"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build", "build", "generate:openapi"]
    },
    "test:types": {
      "dependsOn": ["^build", "build", "generate:openapi"]
    },
    "lint": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:watch": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:ui": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build", "build", "generate:openapi"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    }
  },
  "tui": {
    "enabled": false
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": ["packages/*"],
    "releaseTagPatternCheckAllBranchesWhen": ["alpha", "beta", "next", "rc"],
    "version": {
      "conventionalCommits": true,
      "updateDependents": "never",
      "preserveLocalDependencyProtocols": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "automaticFromRef": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      }
    }
  }
}
