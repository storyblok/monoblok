---
import type { Block } from '../../schema/schema';

interface Props {
  block: Block<'page'>;
}

const { block } = Astro.props;
---

<article class="mx-auto max-w-4xl px-6 py-12" data-block="page">
  {block.seo_title && <h1 class="mb-2 text-4xl font-bold text-balance text-gray-900">{block.seo_title}</h1>}
  {block.seo_description && <p class="mb-8 text-gray-500">{block.seo_description}</p>}
  <slot />
</article>
