{
  "name": "@storyblok/playground-svelte-integration-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174",
    "qa:dev": "vite dev --port 5174",
    "qa:stop": "true # intentionally a no-op; Vite exits with the test process",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@storyblok/api-client": "workspace:*",
    "@storyblok/svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "svelte": "^5.59.2",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.8"
  },
  "nx": {
    "projectType": "application"
  }
}
