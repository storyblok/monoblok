---
import { type StoryblokRichTextTextNode, type StoryblokRichTextMark } from '@storyblok/richtext';
import {
  type StoryblokAstroRichTextRenderContext,
  isValidAstroComponent,
} from '../../richtext-helpers';
import RenderLinkInner from './RenderLinkInner.astro';
import ElementTag from './ElementTag.astro';

interface Props {
  nodes: StoryblokRichTextTextNode[];
  linkMark: StoryblokRichTextMark & { type: 'link' };
  options: StoryblokAstroRichTextRenderContext;
}
const { nodes, linkMark, options } = Astro.props;
const components = options.components;
const Custom = components ? components[linkMark.type] : undefined;
---

{
  isValidAstroComponent(Custom) ? (
    <Custom {...linkMark} context={options}>
      <RenderLinkInner nodes={nodes} options={options} />
    </Custom>
  ) : (
    <ElementTag node={linkMark}>
      <RenderLinkInner nodes={nodes} options={options} />
    </ElementTag>
  )
}
