---
import { client, StoryblokBlock } from "../storyblok";
import BaseLayout from "../components/BaseLayout.astro";

const { data } = await client.stories.get("home", {
  query: {
    version: "draft",
    resolve_relations: "featured-articles.posts",
  },
});

if (!data?.story) {
  throw new Error('Story not found for slug "home"');
}

const story = data.story;
---

<BaseLayout>
  <StoryblokBlock block={story.content} />
</BaseLayout>
