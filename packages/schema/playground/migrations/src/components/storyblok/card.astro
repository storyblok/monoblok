---
import type { Block } from '../../schema/schema';
import { linkHref } from '../../lib/links';
import Richtext from './richtext.astro';

interface Props {
  block: Block<'card'>;
}

const { block } = Astro.props;
const href = linkHref(block.link);
---

<article class="my-6 rounded-xl border border-gray-200 bg-white p-6" data-block="card">
  <h3 class="text-2xl font-semibold text-balance text-gray-900">{block.headline}</h3>
  <p class="mt-1 text-xs text-gray-400">
    {block.slug && <span class="mr-3">/{block.slug}</span>}
    {block.category && <span class="mr-3">category: {block.category}</span>}
    {block.price !== undefined && block.price !== null && <span>price: {block.price}</span>}
  </p>
  <Richtext document={block.body} />
  {block.images?.length ? (
    <div class="mt-4 flex flex-wrap gap-2">
      {block.images.map(image => (
        <img
          src={image.filename ?? ''}
          alt={image.alt ?? ''}
          class="h-24 w-24 rounded object-cover"
          width="96"
          height="96"
        />
      ))}
    </div>
  ) : null}
  {href && <a href={href} class="mt-4 inline-block text-sm text-indigo-600 hover:underline">Read more &rarr;</a>}
</article>
