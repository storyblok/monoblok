{
  "name": "@storyblok/js",
  "version": "6.3.2",
  "private": false,
  "description": "SDK to integrate Storyblok into your project using JavaScript.",
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/js#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vp test run",
    "test:e2e": "start-server-and-test cy:playground http://localhost:5173/ cy:run",
    "cy:playground": "pnpm --filter='./playground/vanilla' dev",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "publint": "publint .",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:e2e:watch": "start-server-and-test cy:playground http://localhost:5173/ cy:open",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@storyblok/preview-bridge": "^2.1.6",
    "@storyblok/richtext": "workspace:^",
    "storyblok-js-client": "workspace:^"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@tsconfig/recommended": "^1.0.8",
    "@types/node": "catalog:",
    "@vitest/ui": "^4.1.10",
    "cypress": "^15.21.0",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "pathe": "catalog:",
    "publint": "catalog:",
    "start-server-and-test": "^2.0.11",
    "typescript": "catalog:",
    "vite": "^6.4.3",
    "vite-plugin-qrcode": "^0.2.4",
    "vitest": "catalog:"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "nx": {
    "implicitDependencies": [
      "!@storyblok/playground-*",
      "storyblok-js-client"
    ]
  }
}
