{
  "name": "@storyblok/experiments",
  "version": "1.2.0",
  "private": false,
  "description": "Runtime A/B testing utilities for the Storyblok experiments API",
  "keywords": [
    "ab-testing",
    "experiments",
    "storyblok"
  ],
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/experiments#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "Storyblok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/experiments"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "adapters": [
        "./dist/adapters.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "import": "./dist/adapters.mjs",
      "require": "./dist/adapters.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate:openapi": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate.ts",
    "test": "vp test run",
    "test:e2e": "vp test run -c vitest.config.e2e.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test:types": "tsc --noEmit --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@storyblok/api-client": "workspace:*",
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/management-api-client": "workspace:*",
    "@storyblok/openapi-codegen": "workspace:*",
    "@types/node": "^24.11.0",
    "dotenv": "^17.3.1",
    "msw": "^2.12.9",
    "oxlint": "1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "nx": {
    "targets": {
      "generate:openapi": {
        "inputs": [
          "{projectRoot}/scripts/generate.ts",
          "{projectRoot}/package.json",
          "openapiCodegen"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true,
        "dependsOn": [
          "@storyblok/openapi-codegen:build"
        ]
      }
    }
  }
}
