---
import {
  getPayload,
  isInEditor,
  StoryblokLivePreview,
  StoryblokServerData,
  type StoryblokBlockData,
} from "@storyblok/astro";
import { client, StoryblokBlock } from "../storyblok";
import BaseLayout from "../components/BaseLayout.astro";
import { getUsers, type User } from "src/lib/getUsers";
import Widget from "../components/Widget.astro";
import UserModal from "../components/UserModal";

interface ServerData {
  users?: User[];
}
interface MyStory {
  content: StoryblokBlockData;
}
const { slug } = Astro.params;
const payload = await getPayload<ServerData, MyStory>({ locals: Astro.locals });

// Use live preview data or fetch fresh data
const response = payload?.story ? undefined : await client.stories.get(slug || "home", {
  query: {
    version: "draft",
    resolve_relations: "featured-articles.posts",
  },
});

const story = payload?.story ?? response?.data?.story;

if (!story) {
  throw new Error(`Story not found for slug "${slug}"`);
}

const users = payload?.serverData?.users ?? (await getUsers());
const inEditor = isInEditor(Astro.url);
const slugs = ["test", "about-us", "contact"];
const disableLivePreview = slugs.includes(slug || "");
---

<BaseLayout>
  <p>{users?.length} users loaded.</p>
  <StoryblokBlock block={story.content} />
  {
    inEditor && (
      <Widget disableLivePreview={disableLivePreview}>
        <UserModal client:load />
      </Widget>
    )
  }
  {!disableLivePreview && <StoryblokLivePreview />}
</BaseLayout>
<StoryblokServerData users={users} />
