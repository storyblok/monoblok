{
  "name": "monoblok-cli",
  "version": "0.1.0",
  "description": "CLI tool for migrating and managing Storyblok projects in the monorepo",
  "type": "module",
  "main": "dist/index.mjs",
  "private": true,
  "bin": {
    "monoblok": "dist/index.mjs"
  },
  "scripts": {
    "build": "vp pack",
    "postinstall": "pnpm run build",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@types/license-checker": "^25.0.6",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^5.1.1",
    "inquirer": "^8.2.5",
    "license-checker": "^25.0.1",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^24.11.0",
    "oxlint": "1.76.0",
    "typescript": "5.8.3"
  }
}
