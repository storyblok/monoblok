{
  "name": "@storyblok/openapi-codegen",
  "version": "0.0.1",
  "private": true,
  "description": "Internal: owns the OpenAPI spec cache and the shared code generator used by consumer packages. Specs are git-ignored; the upstream commit SHA is pinned in spec.lock. Not published.",
  "files": [
    "spec.lock",
    "src",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./templates/*": "./templates/*"
  },
  "scripts": {
    "pull": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fetch.ts",
    "pull:update": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fetch.ts --update",
    "verify": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/verify.ts",
    "build": "vp pack",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:types": "tsc --noEmit --skipLibCheck",
    "dev": "vp pack --watch",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "0.92.4",
    "pathe": "^2.0.3",
    "typescript": "5.8.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@types/node": "^24.11.0",
    "oxlint": "1.76.0",
    "vitest": "^4.1.10"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/spec.lock",
          "{projectRoot}/src/**",
          "{projectRoot}/scripts/**",
          "{projectRoot}/specs/**",
          "{projectRoot}/templates/**",
          "{projectRoot}/.openapi-cache/**",
          "{projectRoot}/vite.config.ts"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true,
        "dependsOn": []
      }
    }
  }
}
