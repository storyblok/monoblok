---
import { StoryblokRichText } from "../storyblok";
import Heading from "./richtext/Heading.astro";
import Bold from "./richtext/Bold.astro";

const { block, editable } = Astro.props;
---

<!-- `data-headline` and `title` derive attributes from a field, for the live-preview attribute spec (#805). -->
<div {...editable} data-headline={block.headline}>
  <h2 class="heading" title={block.headline}>
    {block.headline}
  </h2>
  <StoryblokRichText document={block?.text} components={{ heading: Heading, bold: Bold }} />
</div>
<style>
  .heading {
    text-align: center;
    font: 700 2.25rem/2.5rem sans-serif;
    color: var(--color-primary);
    padding: 3rem 0;
  }
</style>
