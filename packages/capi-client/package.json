{
  "name": "@storyblok/api-client",
  "version": "0.7.1",
  "private": false,
  "description": "Storyblok Content Delivery API Client",
  "keywords": [],
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/capi-client#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/capi-client"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:openapi": "tsx scripts/generate.ts",
    "build": "vp pack",
    "test": "vp test run",
    "test:types": "tsc --noEmit --skipLibCheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "dev": "vp pack --watch",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@storyblok/region-helper": "workspace:*",
    "ky": "^1.14.3"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/management-api-client": "workspace:*",
    "@storyblok/openapi-codegen": "workspace:*",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "pathe": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "generate:openapi": {
        "inputs": [
          "{projectRoot}/scripts/generate.ts",
          "{projectRoot}/package.json",
          "openapiCodegen"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true,
        "dependsOn": [
          "@storyblok/openapi-codegen:build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist/**"
        ]
      }
    }
  }
}
