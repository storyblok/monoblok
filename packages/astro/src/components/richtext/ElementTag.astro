---
import {
  attrsToHtmlString,
  buildAstroAttrs,
  resolveTag,
  isSelfClosing,
  type StoryblokRichTextMark,
  type StoryblokRichTextNode,
} from '../../';
interface Props {
  node:
    Exclude<StoryblokRichTextNode, { type: 'text' }> | StoryblokRichTextMark;
}
const { node } = Astro.props;

const Tag = resolveTag(node);
const attrs = 'attrs' in node ? (node.attrs ?? {}) : {};
const processedAttrs = buildAstroAttrs(node.type, attrs);
const selfClosing = Tag && isSelfClosing(Tag);
---

{
  Tag ? (
    selfClosing ? (
      <Fragment set:html={`<${Tag}${attrsToHtmlString(processedAttrs)}>`} />
    ) : (
      <Tag {...processedAttrs}>
        <slot />
      </Tag>
    )
  ) : (
    <slot />
  )
}
