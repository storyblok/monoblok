---
import {
  type StoryblokRichTextNode,
  type StoryblokAstroRichTextRenderContext,
  buildStoryblokImage,
} from '../../';
import ElementTag from './ElementTag.astro';

type ImageNode = StoryblokRichTextNode & { type: 'image' };
interface Props {
  node: ImageNode;
  options: StoryblokAstroRichTextRenderContext;
}
const { node, options } = Astro.props;
const optimizedNode: ImageNode =
  options.optimizeImage && node?.attrs?.src
    ? {
        ...node,
        attrs: {
          ...node.attrs,
          ...buildStoryblokImage(
            node.attrs.src as string,
            options.optimizeImage,
          ),
        },
        type: 'image',
      }
    : node;
---

<ElementTag node={optimizedNode} />
