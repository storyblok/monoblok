---
import { storyblokEditable, StoryblokRichText } from "@storyblok/astro";
import Heading from "./richtext/Heading.astro";
import Bold from "./richtext/Bold.astro";

const { block } = Astro.props;
---

<div {...storyblokEditable(block)}>
  <h2 class="heading">
    {block.headline}
  </h2>
  <StoryblokRichText document={block?.text} components={{ heading: Heading, bold: Bold }} />
</div>
<style>
  .heading {
    text-align: center;
    font: 700 2.25rem/2.5rem sans-serif;
    color: var(--color-primary);
    padding: 3rem 0;
  }
</style>
