---
import { type StoryblokRichTextNode, buildStoryblokImage } from '@storyblok/richtext';
import type { StoryblokAstroRichTextRenderContext } from '../../richtext-helpers';
import ElementTag from './ElementTag.astro';

type ImageNode = StoryblokRichTextNode & { type: 'image' };
interface Props {
  node: ImageNode;
  options: StoryblokAstroRichTextRenderContext;
}
const { node, options } = Astro.props;
const optimized =
  options.optimizeImage && node?.attrs?.src
    ? buildStoryblokImage(node.attrs.src as string, options.optimizeImage)
    : undefined;
const optimizedNode: ImageNode = optimized
  ? {
      ...node,
      attrs: {
        ...node.attrs,
        ...optimized.attrs,
        src: optimized.src,
      },
      type: 'image',
    }
  : node;
---

<ElementTag node={optimizedNode} />
