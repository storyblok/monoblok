{
  "name": "@storyblok/vue",
  "version": "11.3.0",
  "description": "SDK to integrate Storyblok into your project using Vue.",
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "Storyblok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue.css": "./dist/vue.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "playground": "pnpm run --filter ./playground/vue dev",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vp test run",
    "test:e2e": "pnpm run cy:components",
    "build": "vp pack",
    "test:types": "tsc --noEmit --skipLibCheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "publint": "publint .",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:components": "cypress run --component",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@storyblok/js": "workspace:^",
    "@storyblok/richtext": "workspace:^"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.10",
    "cypress": "^15.21.0",
    "oxlint": "catalog:",
    "pathe": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.0.0",
    "vitest": "catalog:",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.3.10"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "nx": {
    "implicitDependencies": [
      "!@storyblok/playground-*"
    ]
  }
}
