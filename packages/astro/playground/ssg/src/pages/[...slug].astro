---
import { client, StoryblokBlock } from "../storyblok";
import BaseLayout from "../components/BaseLayout.astro";

export async function getStaticPaths() {
  const { data } = await client.links.list();
  const links = Object.values(data?.links ?? {}).filter((link) => !link.is_folder);

  return links.map((link) => {
    return {
      params: { slug: link.slug },
    };
  });
}
const { slug } = Astro.params;

const { data } = await client.stories.get(slug, {
  query: {
    version: "draft",
    resolve_relations: "featured-articles.posts",
  },
});

if (!data?.story) {
  throw new Error(`Story not found for slug "${slug}"`);
}

const story = data.story;
---

<BaseLayout>
  <StoryblokBlock block={story.content} />
</BaseLayout>
