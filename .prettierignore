pnpm-lock.yaml

# OpenAPI codegen output. Ignored for the same reason every `oxlint.config.ts`
# ignores it: the generators own these files.
**/src/generated/

# Overlay OpenAPI specs.
tools/openapi-codegen/specs/

# Tool-generated output. Mirrors the root oxlint.config.ts ignorePatterns: some
# of these are committed (coverage reports, .svelte-kit), and reformatting them
# only churns the next time the tool regenerates them.
**/dist/
**/coverage/
**/.nx/
**/.angular/
**/.svelte-kit/
**/.nuxt/
**/.output/
**/.next/
**/.astro/
**/.cache/

# Blueprints ship their own formatter config to users, and the synced repos must
# match it, not the monorepo style.
blueprints/
