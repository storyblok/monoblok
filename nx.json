{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultProject": "main",
  "parallel": 5,
  "namedInputs": {
    "cjsBuildPlugins": [
      "{workspaceRoot}/tools/cjs/cjs-interop-plugin.ts",
      "{workspaceRoot}/tools/cjs/cjs-deprecation-plugin.ts"
    ],
    "openapiCodegen": [
      "{workspaceRoot}/tools/openapi-codegen/package.json",
      "{workspaceRoot}/tools/openapi-codegen/src/**",
      "{workspaceRoot}/tools/openapi-codegen/specs/**",
      "{workspaceRoot}/tools/openapi-codegen/spec.lock.json",
      "{workspaceRoot}/tools/openapi-codegen/templates/**"
    ],
    "blueprint": [
      "default",
      { "env": "STORYBLOK_DELIVERY_API_TOKEN" },
      "{workspaceRoot}/blueprints/.pnpmfile.cjs",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "!{projectRoot}/node_modules/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "generate:openapi"],
      "inputs": ["default", "^default", "cjsBuildPlugins"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build", "build", "generate:openapi"]
    },
    "test:types": {
      "dependsOn": ["^build", "build", "generate:openapi"]
    },
    "lint": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:watch": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:ui": {
      "dependsOn": ["^build", "generate:openapi"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build", "build", "generate:openapi"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @storyblok/blueprint-sync smoke {projectName}"
      },
      "dependsOn": ["^build"],
      "inputs": ["blueprint", "^default"],
      "cache": false,
      "parallelism": false
    }
  },
  "tui": {
    "enabled": false
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": ["packages/*"],
    "releaseTagPatternCheckAllBranchesWhen": ["alpha", "beta", "next", "rc"],
    "version": {
      "conventionalCommits": true,
      "updateDependents": "never",
      "preserveLocalDependencyProtocols": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "automaticFromRef": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      }
    }
  }
}
