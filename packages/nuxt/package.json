{
  "name": "@storyblok/nuxt",
  "version": "11.2.0",
  "description": "Storyblok Nuxt module",
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/nuxt#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "test:types": "tsc --noEmit --skipLibCheck",
    "dev": "nuxi dev playground --port 3000",
    "dev:build": "nuxi build playground",
    "dev:e2e": "nuxi dev playground --port 3100",
    "qa:dev": "nuxi dev playground --port 3200 --https",
    "qa:editor": "playwright test --config test/visual-editor/playwright.config.ts",
    "prepare:playground": "nuxi prepare playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vp test run",
    "test:e2e": "vp test run -c vitest.config.e2e.ts"
  },
  "dependencies": {
    "@storyblok/vue": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.2.2",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.2.2",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "catalog:",
    "@storyblok/lint-config": "workspace:*",
    "@storyblok/visual-editor-qa": "workspace:*",
    "@types/node": "catalog:",
    "nuxt": "^4.2.2",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "^3.15.0 || ^4.0.0"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@storyblok/playground-*"
    ]
  }
}
