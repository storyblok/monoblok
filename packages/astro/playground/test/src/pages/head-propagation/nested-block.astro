---
import BaseLayout from "../../components/BaseLayout.astro";
import { StoryblokBlock } from "../../storyblok";

// Fixture for e2e/head-propagation.spec.ts: the block nested in another
// registry block, the usual layout of a story (`grid` renders its `columns`
// with `StoryblokBlock`).
const block = {
  _uid: "grid",
  component: "grid",
  columns: [{ _uid: "mdx-note", component: "mdx_note" }],
};
---

<BaseLayout>
  <StoryblokBlock block={block} />
</BaseLayout>
