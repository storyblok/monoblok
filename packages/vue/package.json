{
  "name": "@storyblok/vue",
  "version": "11.2.4",
  "description": "SDK to integrate Storyblok into your project using Vue.",
  "homepage": "https://github.com/storyblok/monoblok/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/storyblok/monoblok/issues"
  },
  "license": "MIT",
  "author": "Storyblok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storyblok/monoblok.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/storyblok-vue.cjs",
  "module": "./dist/storyblok-vue.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/storyblok-vue.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/storyblok-vue.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp build --watch",
    "playground": "pnpm run --filter ./playground/vue dev",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vp test run",
    "test:e2e": "pnpm run cy:components",
    "build": "vp build",
    "test:types": "tsc --noEmit --skipLibCheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "publint": "publint .",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:components": "cypress run --component",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@storyblok/js": "workspace:*",
    "@storyblok/richtext": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@storyblok/lint-config": "workspace:*",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "cypress": "^14.3.3",
    "kolorist": "^1.8.0",
    "oxlint": "1.76.0",
    "pathe": "^2.0.3",
    "publint": "^0.3.22",
    "typescript": "5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-banner": "^0.8.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "nx": {
    "implicitDependencies": [
      "!@storyblok/playground-*"
    ]
  }
}
