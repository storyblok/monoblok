---
import { type StoryblokAstroRichTextRenderContext, type StoryblokRichTextNode, getStaticChildren, hasContent, resolveTag } from '../../';
import RenderChildren from './RenderChildren.astro';
import RenderStaticStructure from './RenderStaticStructure.astro';

interface Props {
  node: Exclude<StoryblokRichTextNode, { type: 'text' }>;
  options: StoryblokAstroRichTextRenderContext;
}
const { node, options } = Astro.props;
const staticChildren = getStaticChildren(node);
const OuterTag = resolveTag(node);

const attrs = 'attrs' in node ? (node.attrs ?? {}) : {};
---

{
  staticChildren && OuterTag ? (
    <OuterTag>
      <RenderStaticStructure type={node.type} specs={staticChildren} parentAttrs={attrs}>
        {hasContent(node) && <RenderChildren nodes={node.content} options={options} />}
      </RenderStaticStructure>
    </OuterTag>
  ) : null
}
