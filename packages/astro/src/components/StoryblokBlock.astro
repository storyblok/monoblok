---
import { storyblokEditable } from "@storyblok/live-preview";
import { isValidAstroComponent } from "../richtext-helpers";
import type { StoryblokBlockData, StoryblokComponentMap, AstroComponentFactory } from "../types";

type Props = {
  /** The block to render. */
  block?: StoryblokBlockData;
  /**
   * Map of Storyblok technical block names to the components rendering them.
   *
   * Namespaced so a user-declared `components`/`fallback` extra prop (see
   * `defineStoryblokBlocks<TExtraProps>()`) passes through untouched instead
   * of colliding with the registry.
   */
  __storyblokComponents: StoryblokComponentMap;
  /** Rendered for block types that are not present in `__storyblokComponents`. */
  __storyblokFallback?: AstroComponentFactory;
} & Record<string, any>;

const { block, __storyblokComponents: components, __storyblokFallback: fallback, ...rest } =
  Astro.props;

if (!block && import.meta.env.DEV) {
  console.warn(
    "[storyblok] <StoryblokBlock /> received an undefined `block` prop and rendered nothing. " +
      "Check that the value you're passing in exists, e.g. `story?.content` when the fetch " +
      "may have failed, or a typo in the prop name (`block`, not `blok`).",
  );
}

const Component = block ? resolve(block) : undefined;
const editable = block ? storyblokEditable(block) : undefined;

function resolve(block: StoryblokBlockData): AstroComponentFactory | undefined {
  const name = block.component;
  const registered = name ? components[name] : undefined;

  if (registered) {
    if (isValidAstroComponent(registered)) {
      return registered;
    }
    if (import.meta.env.DEV) {
      console.warn(
        `[storyblok] The component registered for block type "${name}" isn't a valid Astro ` +
          `component. Wrap framework components (React, Vue, ...) in an \`.astro\` component ` +
          `with the appropriate \`client:*\` directive instead of registering them directly.`,
      );
    }
  }

  if (fallback) {
    // Held to the same bar as a registered component: a `fallback` that
    // isn't a real Astro component factory would otherwise fail silently,
    // with no warning telling you why nothing rendered.
    if (isValidAstroComponent(fallback)) {
      return fallback;
    }
    if (import.meta.env.DEV) {
      console.warn(
        "[storyblok] The `fallback` passed to `defineStoryblokBlocks` isn't a valid Astro " +
          "component. Wrap framework components (React, Vue, ...) in an `.astro` component " +
          "with the appropriate `client:*` directive instead of passing them directly.",
      );
    }
    return undefined;
  }

  if (import.meta.env.DEV) {
    console.warn(
      `[storyblok] No component registered for block type "${name}". ` +
        `Register it in \`defineStoryblokBlocks(() => ({ components }))\` or provide a \`fallback\`.`,
    );
  }

  return undefined;
}
---

{Component && <Component block={block} editable={editable} {...rest} />}
