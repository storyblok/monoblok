---
import {
  normalizeNodes,
  type StoryblokRichTextImageOptions,
  type StoryblokRichTextInput,
} from "@storyblok/richtext";
import type { StoryblokAstroRichTextComponentMap } from "../richtext-helpers";
import RenderChildren from "./richtext/RenderChildren.astro";

interface Props {
  document: StoryblokRichTextInput;
  optimizeImage?: boolean | StoryblokRichTextImageOptions;
  components?: StoryblokAstroRichTextComponentMap;
  data?: unknown;
}

const { document, components, optimizeImage, data } = Astro.props;
const nodes = normalizeNodes(document);
---

<RenderChildren nodes={nodes} options={{ components, optimizeImage, data }} />
