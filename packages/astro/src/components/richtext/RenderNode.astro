---
import {
  type StoryblokRichTextNode,
  type StoryblokAstroRichTextRenderContext,
  isValidAstroComponent,
  getStaticChildren,
  hasContent,
} from '../../';
import StoryblokComponent from '../StoryblokComponent.astro';
import RenderChildren from './RenderChildren.astro';
import ElementTag from './ElementTag.astro';
import RenderImage from './RenderImage.astro';
import RenderStaticChildren from './RenderStaticChildren.astro';
import RenderTable from './RenderTable.astro';
import RenderTextNodeWithMarks from './RenderTextNodeWithMarks.astro';
import type { SbBlokData } from '../../';

interface Props {
  node: StoryblokRichTextNode;
  options: StoryblokAstroRichTextRenderContext;
}
const { node, options } = Astro.props;
const components = options.components;
const Custom = components ? components[node.type] : undefined;

// When passing context to a custom component, exclude that component type
// to prevent infinite loops if the custom component uses StoryblokRichText internally
const contextForCustom = Custom
  ? { ...options, components: { ...components, [node.type]: undefined } }
  : options;
---

{
  isValidAstroComponent(Custom) ? (
    <Custom {...node} context={contextForCustom}>
      {hasContent(node) ? (
        <RenderChildren nodes={node.content} options={options} />
      ) : null}
    </Custom>
  ) : node.type === 'text' ? (
    <RenderTextNodeWithMarks node={node} marks={node.marks} options={options} />
  ) : node.type === 'image' ? (
    <RenderImage node={node} options={options} />
  ) : node.type === 'blok' ? (
    <Fragment>
      {Array.isArray(node.attrs?.body) &&
        node.attrs.body.map((blok, index) => (
          <StoryblokComponent
            blok={blok as SbBlokData}
            key={blok._uid || index}
          />
        ))}
    </Fragment>
  ) : node.type === 'table' ? (
    <RenderTable node={node} options={options} />
  ) : node.type === 'emoji' ? (
    <ElementTag node={node}>{node.attrs.emoji}</ElementTag>
  ) : getStaticChildren(node) ? (
    <RenderStaticChildren node={node} options={options} />
  ) : (
    <ElementTag node={node}>
      {hasContent(node) && (
        <RenderChildren nodes={node.content} options={options} />
      )}
    </ElementTag>
  )
}
