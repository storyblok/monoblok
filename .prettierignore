pnpm-lock.yaml

# Committed OpenAPI codegen output. Ignored for the same reason every
# `oxlint.config.ts` ignores it: the generators own these files, and formatting
# them would drift on the next regeneration.
**/src/generated/

# Vendored OpenAPI specs, mirrored from storyblok/openapi-wdx and pinned by
# spec.lock. Reformatting them would diverge from upstream and be undone by the
# next `pnpm --filter @storyblok/openapi-codegen pull`.
tools/openapi-codegen/specs/

# Tool-generated output. Mirrors the root oxlint.config.ts ignorePatterns: some
# of these are committed (coverage reports, .svelte-kit), and reformatting them
# only churns the next time the tool regenerates them.
**/dist/
**/coverage/
**/.nx/
**/.angular/
**/.svelte-kit/
**/.nuxt/
**/.output/
**/.next/
**/.astro/
**/.cache/

# Generated story fixtures for the migrations playground. Same rationale as the
# codegen output: `pnpm fixtures` owns these files, and reformatting them means
# every regeneration and every offline migration run leaves a reflow diff.
packages/schema/playground/migrations/fixtures/

# Migrated content recorded by the catalogue harness. The harness writes these
# with `UPDATE_EXPECTED=1`, so reformatting them means every regeneration leaves
# a reflow diff on top of the content diff a reviewer is there to read.
packages/schema/playground/migrations/test/expected/
