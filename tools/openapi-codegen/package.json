{
  "name": "@storyblok/openapi-codegen",
  "version": "0.0.1",
  "private": true,
  "description": "Internal: the OpenAPI spec pins and the shared code generator for consumer packages.",
  "files": [
    "src",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./templates/*": "./templates/*"
  },
  "scripts": {
    "pull": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fetch.ts",
    "build": "vp pack",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:types": "tsc --noEmit --skipLibCheck",
    "dev": "vp pack --watch",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "pathe": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@storyblok/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/src/**",
          "{projectRoot}/scripts/**",
          "{projectRoot}/spec.lock.json",
          "{projectRoot}/specs/**",
          "{projectRoot}/templates/**",
          "{projectRoot}/vite.config.ts"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true,
        "dependsOn": []
      }
    }
  }
}
